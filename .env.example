# ============================================================
# RAG 中文文档问答系统 · 环境配置模板
# 复制为 .env 并填入真实值（.env 已 gitignore，勿提交）
# ============================================================

# ---------- 阿里云百炼（DashScope）：embedding / rerank ----------
DASHSCOPE_API_KEY=your_dashscope_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 嵌入模型（供应商可切换：注释/取消注释区块即可）----------
# 方式 A：腾讯 MaaS TokenHub · Kinfra（OpenAI 兼容；每模型 100 万 tokens 赠送）
EMBED_PROVIDER=openai
EMBED_API_MODEL=kinfra-text-embedding-4b       # 备选：kinfra-text-embedding-0.6b / kinfra-vl-embedding-8b / -2b
EMBED_BASE_URL=https://tokenhub.tencentmaas.com/v1
EMBED_API_KEY=your_tencent_maas_key_here
# ⚠️ 不同模型向量空间不同，换模型必须重建索引

# 方式 B：阿里云百炼 DashScope（OpenAI 兼容）
# EMBED_PROVIDER=dashscope
# EMBED_API_MODEL=qwen3.7-text-embedding-flash
# EMBED_DIMENSIONS=1024                        # 0/缺省 = 用模型原生维度

# 方式 C：本地 BGE（无 GPU 不推荐，需先下载模型到 models/）
# EMBED_MODE=local
# EMBED_LOCAL_MODEL=models/bge-m3

# ---------- 重排序模型 ----------
# 模式: api (DashScope) 或 local (CrossEncoder)
RERANK_MODE=api
RERANK_API_MODEL=qwen3.7-text-rerank
# RERANK_LOCAL_MODEL=models/bge-reranker-base

# ---------- 生成模型（OpenAI 兼容端点；默认 DeepSeek 官方）----------
# GEN_* 未设置时回退到 LLM_BASE_URL / DASHSCOPE_API_KEY / LLM_MODEL_ID（过渡期兼容）
GEN_API_KEY=your_deepseek_key_here
GEN_BASE_URL=https://api.deepseek.com
GEN_MODEL_ID=deepseek-flash
# 备选：腾讯 MaaS TokenHub（OpenAI 兼容，含 deepseek / glm / kimi 等）
# GEN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# GEN_API_KEY=your_tencent_maas_key_here
# GEN_MODEL_ID=deepseek/deepseek-flash

# ---------- 路径 ----------
FAISS_PERSIST_DIR=faiss_db
DATA_DIR=data
UPLOAD_DIR=data/uploads
PAPERS_DIR=data/papers
